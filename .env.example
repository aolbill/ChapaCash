NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# MongoDB Atlas or local — do not commit real credentials
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0

COOKIE_SECURE=false
COOKIE_NAME=chapacash_session

DEMO_PLAYER_EMAIL=player@chapacash.test
DEMO_PLAYER_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
DEMO_ADMIN_EMAIL=admin@chapacash.test
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

FAIRNESS_CLIENT_SEED=chapacash-public-v1
FAIRNESS_ALGORITHM_VERSION=hmac-sha256-crash-v1
PROMO_CREDIT_AMOUNT=10000

ENGINE_TICK_MS=100
BETTING_WINDOW_MS=15000
INTERMISSION_MS=4000
GROWTH_PER_SECOND=0.06

# Paystack (Kenya M-PESA STK). Use test secret sk_test_… until go-live.
PAYSTACK_SECRET_KEY=CHANGE_ME
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_MPESA_PROVIDER=mpesa
PAYSTACK_CURRENCY=KES
PAYSTACK_CALLBACK_URL=https://fidel-castro-portfolio.vercel.app/verify
PAYSTACK_WEBHOOK_URL=https://fidel-castro-portfolio.vercel.app/verify
PAYSTACK_PAYOUTS_ENABLED=false

# M-PESA withdrawals need a Registered Paystack business with Transfers enabled (Starter cannot send third-party payouts). Disable Transfer OTP in the dashboard. Set PAYSTACK_PAYOUTS_ENABLED=true after that.

